# backend/.env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.

# ── Groq AI chatbot ──────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
CHAT_MAX_TOKENS=800
CHAT_TEMPERATURE=0.4
CHAT_MAX_HISTORY=10

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS (comma-separated frontend origins) ──────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Model (leave empty if model weights not available) ───────────────────────
MODEL_WEIGHTS_PATH=
MODEL_THRESHOLD=0.5
MODEL_VERIFIED=false

# ── Database & uploads ───────────────────────────────────────────────────────
DB_PATH=data/swasthyascan.db
UPLOADS_DIR=data/uploads
ENVIRONMENT_EXPIRY_HOURS=24.0

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
