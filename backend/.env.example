# PulmoSure AI — Backend Environment Configuration EXAMPLE
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.

# ── Server ──────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ── Model ───────────────────────────────────────────────────────
# Leave empty to run in "model not configured" mode (honest unavailable state).
# Set to absolute path of your trained model checkpoint when available.
MODEL_WEIGHTS_PATH=

# ── Upload limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Groq Chatbot ────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
# SERVER-SIDE ONLY — never put in frontend code or commit to Git.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
CHAT_MAX_TOKENS=800
CHAT_TEMPERATURE=0.4
CHAT_MAX_HISTORY=10
